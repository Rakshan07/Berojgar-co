
# Password-reset sender (server only; enter real credentials in ignored .env)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
PUBLIC_APP_URL=http://localhost:5174

# Social sign-in credentials (not Gmail SMTP App Passwords)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
