# Password-reset sender (server only; enter real credentials in ignored .env)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
PUBLIC_APP_URL=http://localhost:5173

# Social sign-in credentials (not Gmail SMTP App Passwords)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Gemini AI Configuration (Free-Tier: e.g. gemini-2.5-flash)
# Get a free key at https://aistudio.google.com/
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Optional alternate Gemini models for temporary service outages (same API key).
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
