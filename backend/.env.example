# Change only this line to move to Postgres, e.g.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/teamweave
DATABASE_URL=sqlite:///./teamweave.db

# Leave empty to run at zero cost: /ai/suggestions serves static suggestions.
ANTHROPIC_API_KEY=

# Password-reset OTP emails. Leave SMTP_HOST empty in dev: the code is printed to the server console.
# For Gmail: enable 2-step verification, create an "App password", then:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
